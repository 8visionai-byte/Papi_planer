// prisma/schema.prisma
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      UserRole @default(USER)
  googleId  String?  @unique @map("google_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile             UserProfile?
  lifeAreas           LifeArea[]
  mentors             Mentor[]
  dailyLogs           DailyLog[]
  weeklyCheckins      WeeklyCheckin[]
  roundTableSessions  RoundTableSession[]
  briefings           Briefing[]
  files               UserFile[]
  schedules           Schedule[]
  feedback            Feedback[]
  goals               Goal[]
  mentorPlans         MentorPlan[]
  trainingLogs        TrainingLog[]
  personalRecords     PersonalRecord[]
  weightEntries       WeightEntry[]
  habits              Habit[]
  journalEntries      JournalEntry[]
  journalAgentConfig  JournalAgentConfig?
  meetingCompletions  MeetingCompletion[]
  mentorConversations MentorConversation[]
  insights            UserInsight[]
  mealIdeas           MealIdea[]
  changeProposals     ChangeProposal[]
  energyPillars       EnergyPillar[]
  energyEntries       EnergyEntry[]

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  data   Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model LifeArea {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  name        String
  slug        String?
  category    String?
  description String? @db.Text
  priority    Int     @default(0)
  active      Boolean @default(true)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentors         Mentor[]         @relation("MentorLifeAreas")
  activities      Activity[]
  schedules       Schedule[]
  goals           Goal[]
  trainingLogs    TrainingLog[]
  personalRecords PersonalRecord[]
  energyPillars   EnergyPillar[]

  @@map("life_areas")
}

model TrainingLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  lifeAreaId   String   @map("life_area_id")
  date         DateTime @default(now())
  exerciseName String   @map("exercise_name")
  sets         Int?
  reps         Int?
  weightKg     Float?   @map("weight_kg")
  durationMin  Int?     @map("duration_min")
  distance     Float?
  notes        String?  @db.Text
  rating       Int?
  metrics      Json?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeArea LifeArea @relation(fields: [lifeAreaId], references: [id], onDelete: Cascade)

  @@index([userId, lifeAreaId, date])
  @@map("training_logs")
}

model PersonalRecord {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  lifeAreaId   String   @map("life_area_id")
  exerciseName String   @map("exercise_name")
  value        Float
  unit         String
  achievedAt   DateTime @default(now()) @map("achieved_at")
  notes        String?  @db.Text

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeArea LifeArea @relation(fields: [lifeAreaId], references: [id], onDelete: Cascade)

  @@index([userId, lifeAreaId])
  @@map("personal_records")
}

model Mentor {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  name         String
  role         String
  persona      String  @db.Text
  systemPrompt String  @map("system_prompt") @db.Text
  style        String?
  model        String  @default("claude-sonnet-4-6")
  active       Boolean @default(true)
  sortOrder    Int     @default(0) @map("sort_order")
  avatarEmoji  String? @default("🧑‍🏫") @map("avatar_emoji")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeAreas     LifeArea[]           @relation("MentorLifeAreas")
  goals         Goal[]
  mentorPlans   MentorPlan[]
  conversations MentorConversation[]

  @@map("mentors")
}

model MentorConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mentorId  String   @map("mentor_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor   Mentor              @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  messages MentorChatMessage[]

  @@index([userId, mentorId, updatedAt])
  @@map("mentor_conversations")
}

model MentorChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("mentor_chat_messages")
}

model DailyLog {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  date              DateTime @db.Date
  dayType           String?  @map("day_type")
  energy            Int?
  sleepHours        Float?   @map("sleep_hours")
  sleepQuality      Int?     @map("sleep_quality")
  mood              String?
  voiceTranscript   String?  @map("voice_transcript") @db.Text
  protocolActivated String?  @map("protocol_activated")
  createdAt         DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  meals      Meal[]

  @@unique([userId, date])
  @@map("daily_logs")
}

model Activity {
  id              String  @id @default(cuid())
  dailyLogId      String  @map("daily_log_id")
  lifeAreaId      String? @map("life_area_id")
  type            String
  name            String
  scheduledAt     String? @map("scheduled_at")
  durationMin     Int?    @map("duration_min")
  completed       Boolean @default(false)
  metrics         Json?
  notes           String? @db.Text
  /// Stable link back to the MentorPlan task this activity came from.
  /// Replaces matching plan tasks by title (which broke on rename / duplicates).
  sourcePlanId    String? @map("source_plan_id")
  sourceTaskIndex Int?    @map("source_task_index")
  /// The habit this slot IS, when the day plan scheduled one.
  ///
  /// The owner ticked "poranna Vipassana" on the habits screen and the identical line in
  /// the day plan stayed open, because nothing tied the two rows together. Matching by
  /// title was never going to hold ("Vipassana poranna" vs "poranna vipassana 20 min"),
  /// so the match is made ONCE, when the plan is written, and stored here. From then on
  /// ticking either side is a primary-key lookup, not a guess.
  habitId         String? @map("habit_id")

  dailyLog DailyLog  @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  lifeArea LifeArea? @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)
  habit    Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)

  @@index([dailyLogId])
  @@index([sourcePlanId, sourceTaskIndex])
  @@index([habitId])
  @@map("activities")
}

model Meal {
  id          String  @id @default(cuid())
  dailyLogId  String  @map("daily_log_id")
  time        String
  name        String
  calories    Int?
  protein     Float?
  carbs       Float?
  fat         Float?
  description String?

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@map("meals")
}

model WeeklyCheckin {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  weekNumber   Int      @map("week_number")
  date         DateTime @db.Date
  weight       Float?
  measurements Json?
  areaStats    Json?    @map("area_stats")
  energyAvg    Float?   @map("energy_avg")
  wins         String?  @db.Text
  fails        String?  @db.Text
  mentorNotes  Json?    @map("mentor_notes")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber])
  @@map("weekly_checkins")
}

model RoundTableSession {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  inputText        String   @map("input_text") @db.Text
  inputType        String   @default("text") @map("input_type")
  consensus        String?  @db.Text
  debateTranscript Json?    @map("debate_transcript")
  planChanges      Json?    @map("plan_changes")
  applied          Boolean  @default(false)
  /// "running" | "done" | "error". The debate used to live inside the HTTP stream, so
  /// locking the phone killed it and the user saw "internet error" with the work lost.
  /// The row is now created first and filled in by a background task; the screen just
  /// polls this. Default "done" keeps every pre-existing row correct.
  status           String   @default("done")
  error            String?  @db.Text
  /// Touched by the background task on every event. A row stuck in "running" with an
  /// old timestamp means the container restarted mid-debate.
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("round_table_sessions")
}

model Briefing {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  content   String   @db.Text
  audioUrl  String?  @map("audio_url") @db.Text
  phase     Int?
  week      Int?
  dayType   String?  @map("day_type")
  finalized Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("briefings")
}

model UserFile {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  filename  String
  path      String
  mimeType  String   @map("mime_type")
  size      Int
  analysis  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("files")
}

model Schedule {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  dayOfWeek    Int     @map("day_of_week")
  time         String
  activityName String  @map("activity_name")
  lifeAreaId   String? @map("life_area_id")
  recurring    Boolean @default(true)
  notes        String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeArea LifeArea? @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)

  @@map("schedules")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String   @default("change")
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Goal {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  mentorId    String?   @map("mentor_id")
  mentorIds   String[]  @default([]) @map("mentor_ids")
  lifeAreaId  String?   @map("life_area_id")
  title       String
  description String?   @db.Text
  targetDate  DateTime? @map("target_date") @db.Date
  /// "active" | "achieved" | "abandoned" | "paused".
  /// Anything other than "active" is invisible to the day planner and to the
  /// mentors' context - closing a goal is how the user stops being reminded of
  /// an exam they already passed, without hunting for it in a JSON blob.
  status      String    @default("active")
  progress    Int       @default(0)
  /// When the goal was closed (achieved or abandoned). Kept for the record.
  achievedAt  DateTime? @map("achieved_at")
  /// One line from the user: how it actually went. Feeds long-term memory.
  outcome     String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor      Mentor?         @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  lifeArea    LifeArea?       @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)
  milestones  GoalMilestone[]
  mentorPlans MentorPlan[]

  @@map("goals")
}

model GoalMilestone {
  id        String  @id @default(cuid())
  goalId    String  @map("goal_id")
  title     String
  completed Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_milestones")
}

model MentorPlan {
  id         String  @id @default(cuid())
  mentorId   String  @map("mentor_id")
  userId     String  @map("user_id")
  goalId     String? @map("goal_id")
  weekNumber Int     @map("week_number")
  phase      Int     @default(1)
  tasks      Json
  notes      String? @db.Text

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   Goal?  @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, mentorId, weekNumber])
  @@index([userId])
  @@map("mentor_plans")
}

model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole @default(USER)
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("allowed_emails")
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  weightKg  Float    @map("weight_kg")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("weight_entries")
}

model Habit {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  timeOfDay   String   @default("any") @map("time_of_day")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  /**
   * ---- habit loop (Duhigg / Clear) ---------------------------------------
   * A habit is never "willpower". It is cue -> routine -> reward, and a habit
   * you want gone cannot be deleted, only SWAPPED: keep the cue, keep the
   * reward, change what happens in between. These columns are what the app
   * shows under each habit and what the mentors reason about, so a habit stops
   * being a naked checkbox the user cannot argue with at 6am.
   */

  /// What starts it. "Po odstawieniu kubka po kawie", "Gdy siadam do biurka".
  cue      String? @db.Text
  /// What you actually do, spelled out. Defaults to `name` when empty.
  routine  String? @db.Text
  /// What the brain gets out of it - the reason it sticks. "Spokój w głowie".
  reward   String? @db.Text
  /// The long game. "Lepsza wydajność przez cały dzień".
  why      String? @db.Text
  /// Who this makes you. "Jestem kimś, kto zaczyna dzień od siebie".
  identity String?
  /// "build" = a new habit, "replace" = installed in place of an old one.
  kind     String  @default("build")
  /// The old behaviour being swapped out. Free text - it is rarely a Habit row.
  replaces String? @db.Text

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       HabitCompletion[]
  /// Day-plan slots that are this habit. Ticking either side ticks the other.
  activities Activity[]

  @@index([userId, active])
  @@map("habits")
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String   @map("habit_id")
  userId    String   @map("user_id")
  date      DateTime @db.Date
  completed Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_completions")
}

model JournalEntry {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  rawText      String   @map("raw_text") @db.Text
  redactedText String?  @map("redacted_text") @db.Text
  category     String? // "Myśl" | "Refleksja" | "Wniosek" | "Doświadczenie"
  topic        String? // "zdrowie" | "dzieci" | "dziewczyna" | "biznes" | "inne"
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("journal_entries")
}

model JournalAgentConfig {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  systemPrompt String   @map("system_prompt") @db.Text
  model        String   @default("claude-sonnet-4-6")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_agent_config")
}

/// Long-term memory of the AI brain: condensed, human-readable conclusions about
/// the user. Rows are never hard-deleted, only deactivated (active = false), so the
/// user can correct what the app believes about them without losing history.
model UserInsight {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  /// "weekly_summary" | "pattern" | "preference" | "milestone" | "user_note"
  kind       String
  /// "app" = written by the weekly agent, "user" = written by the user themselves.
  /// A user-written note always outranks an app-written one on the same subject.
  origin     String   @default("app")
  /// e.g. "2026-W31" for weekly summaries; null for open-ended insights
  period     String?
  title      String
  content    String   @db.Text
  /// What the conclusion was derived from (counts, record ids)
  evidence   Json?
  confidence Float    @default(0.5)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, period])
  @@index([userId, kind, active])
  @@map("user_insights")
}

/// A meal the dietitian proposed (or the user saved), with the user's verdict on it.
///
/// Exists because the diet advice repeated "200 g twarogu" forever: nothing recorded
/// which meals the user actually liked, so every suggestion started from zero. Rating
/// and `timesCooked` are what turn a generic suggestion engine into a shortlist of
/// meals this particular person eats.
model MealIdea {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  title        String
  description  String?   @db.Text
  /// string[] - ingredients with amounts, ready for a shopping list
  ingredients  Json?
  /// string[] - short steps, 15-20 minutes of work, no restaurant projects
  steps        Json?
  prepMinutes  Int?      @map("prep_minutes")
  calories     Int?
  protein      Float?
  carbs        Float?
  fat          Float?
  /// e.g. ["szybkie", "wysokobialkowe", "obiad"]
  tags         String[]  @default([])
  /// "ai" | "web" | "user"
  source       String    @default("ai")
  sourceUrl    String?   @map("source_url")
  /// -1 = nie chcę tego więcej, 0 = bez zdania, 1 = dawaj częściej
  rating       Int       @default(0)
  favorite     Boolean   @default(false)
  timesCooked  Int       @default(0) @map("times_cooked")
  lastCookedAt DateTime? @map("last_cooked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, title])
  @@index([userId, favorite])
  @@index([userId, rating])
  @@map("meal_ideas")
}

/// A change an agent WANTS to make to the user's data, parked until the user says yes.
///
/// The rule the user set: nothing gets edited or removed behind their back. An agent
/// writes what it understood in one plain sentence, the user taps accept or reject,
/// and only then does the payload touch a real row. Rejected rows stay for the record.
model ChangeProposal {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  /// What triggered it - the user's own note, or the insight being revised.
  sourceText String    @map("source_text") @db.Text
  /// "goal" | "insight" | "habit" | "profile"
  entity     String
  entityId   String?   @map("entity_id")
  /// "create" | "update" | "deactivate"
  action     String
  /// The sentence the user reads: "Cel 'Egzamin karate' oznaczę jako osiągnięty".
  summary    String    @db.Text
  /// Field-level payload applied verbatim on accept.
  payload    Json
  /// "pending" | "accepted" | "rejected"
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at")
  decidedAt  DateTime? @map("decided_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("change_proposals")
}

/**
 * ===========================================================================
 * ENERGIA DNIA
 * The core idea of the app, in the owner's words: "to ma być aplikacja do
 * zwiększania swojej energii". One number per day, built from seven pillars whose
 * weights sum to 100, each pillar built from its own components.
 * Why three tables instead of one wide row: the pillars, their weights and their
 * components are all user-editable. Hardcoding "water = 15%" into the code would
 * mean a deploy every time he re-tunes his own system, and re-tuning it is the
 * entire point. `EnergyEntry.values` is a JSON bag keyed by component key, so a new
 * component never needs a migration.
 * ===========================================================================
 */

/// One of the seven pillars of daily energy. `weight` is its share of the day (%).
model EnergyPillar {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  /// Stable machine key: "umysl" | "odzywianie" | "nawodnienie" | "ruch" | "sen" |
  /// "swieze-powietrze" | "suplementacja". Code keys off this, never off `name`.
  key        String
  name       String
  emoji      String   @default("✨")
  /// Share of total daily energy in percent. All active pillars should sum to 100.
  weight     Int
  /// Optional link to the life area a mentor can be assigned to.
  lifeAreaId String?  @map("life_area_id")
  sortOrder  Int      @default(0) @map("sort_order")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifeArea   LifeArea?         @relation(fields: [lifeAreaId], references: [id], onDelete: SetNull)
  components EnergyComponent[]

  @@unique([userId, key])
  @@index([userId, active])
  @@map("energy_pillars")
}

/// One measurable thing inside a pillar (water in ml, minutes outdoors, salt yes/no).
model EnergyComponent {
  id        String  @id @default(cuid())
  pillarId  String  @map("pillar_id")
  /// Unique within the user; also the key used inside `EnergyEntry.values`.
  key       String
  label     String
  /// How the value turns into a percentage:
  ///   "up"     - more is better up to `target` (water, minutes outdoors)
  ///   "window" - hitting `target` is best, drifting either way costs (calories)
  ///   "bool"   - done or not (salt in the water, room aired)
  kind      String  @default("up")
  /// Where the value comes from: null = the user types it,
  /// otherwise one of the readers in src/lib/energy/sources.ts
  /// ("calories" | "protein" | "activity-minutes" | "sleep-hours" | "study-minutes" |
  ///  "meditation-minutes" | "habits-done").
  source    String?
  /// Value that scores 100%.
  target    Float
  /// Only for "window": how far from `target` still scores above zero.
  tolerance Float?
  unit      String?
  /// Share of the pillar in percent. Components of one pillar should sum to 100.
  weight    Int
  /// Shown under the field so the user knows what "good" means for him.
  hint      String?
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  pillar EnergyPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@index([pillarId, active])
  @@map("energy_components")
}

/// What the user actually did on one day, plus the score computed from it.
model EnergyEntry {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  date       DateTime @db.Date
  /// { "<componentKey>": number } - booleans are 0 or 1. Only manual components live
  /// here; anything with a `source` is read from the rest of the app at scoring time.
  values     Json     @default("{}")
  /// Cached result: { total: number, pillars: { "<pillarKey>": number } }.
  /// Recomputed on every write. Stored so 30-day trends are one query, not 30 rebuilds.
  score      Json?
  /// How the user actually felt, 1-10. The whole point of the trend screen is comparing
  /// this against `score.total` and finding which pillar explains the gap.
  feltEnergy Int?     @map("felt_energy")
  note       String?  @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("energy_entries")
}

model MeetingCompletion {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  externalId  String   @map("external_id")
  date        DateTime @db.Date
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId, date])
  @@index([userId, date])
  @@map("meeting_completions")
}
